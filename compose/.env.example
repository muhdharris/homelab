# Copy to .env beside the compose file and fill in. Never commit the real .env.
# On the live host .env is chmod 600, and each service has its own file with its own
# credentials rather than sharing one.

# ---------- immich.yml ----------
# variable names here must match exactly what immich.yml references
DB_USERNAME=immich
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./data
UPLOAD_LOCATION=./upload
IMMICH_VERSION=release

# ---------- firefly.yml ----------
# Firefly reads DB_USERNAME and DB_PASSWORD from its own .env. Different values from
# Immich's, even though the key names are the same, because they are separate databases.
DB_USERNAME=firefly
DB_PASSWORD=change-me

# ---------- pihole.yml ----------
PIHOLE_WEBPASSWORD=change-me
TZ=Asia/Kuala_Lumpur
