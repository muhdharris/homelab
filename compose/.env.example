# Copy to .env and fill in. Never commit the real .env.
# On the live host .env is chmod 600.

# --- pihole ---
PIHOLE_WEBPASSWORD=change-me
TZ=Asia/Kuala_Lumpur

# --- immich (Postgres) ---
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=immich
DB_DATA_LOCATION=./data

# --- firefly (Postgres) ---
# same DB_* keys are reused by the firefly db service
