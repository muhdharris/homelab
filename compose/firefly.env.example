# Firefly III — self-hosted finance
#
# Copy beside firefly.yml and fill in, then bring the service up with:
#
#   docker compose --env-file firefly.env -f firefly.yml up -d
#
# Never commit the real firefly.env. On the live host it is chmod 600, and the
# .gitignore here already covers it.
#
# Named after the service rather than a shared .env: a single .env gets overwritten
# when you set up the next service, and the firefly.yml filename is not one Compose
# auto-detects, so both the file and the flag have to be explicit.

DB_USERNAME=firefly
DB_PASSWORD=change-me
