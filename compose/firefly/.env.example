# Firefly III — self-hosted finance
#
#   cp .env.example .env    # then fill it in
#   docker compose up -d
#
# Never commit .env. On the live host it is chmod 600, and the .gitignore in the
# parent directory covers it.
#
# One directory per service on purpose: a single shared .env gets overwritten
# when you set up the next service, and the compose file is named
# docker-compose.yml so Compose finds it without an explicit -f.

DB_USERNAME=firefly
DB_PASSWORD=change-me
