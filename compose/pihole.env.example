# Pi-hole — network-wide DNS sinkhole
#
# Copy beside pihole.yml and fill in, then bring the service up with:
#
#   docker compose --env-file pihole.env -f pihole.yml up -d
#
# Never commit the real pihole.env. On the live host it is chmod 600, and the
# .gitignore here already covers it.
#
# Named after the service rather than a shared .env: a single .env gets overwritten
# when you set up the next service, and the pihole.yml filename is not one Compose
# auto-detects, so both the file and the flag have to be explicit.

PIHOLE_WEBPASSWORD=change-me
TZ=Asia/Kuala_Lumpur
