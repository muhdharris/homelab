# Immich — photo and video management
#
# Copy beside immich.yml and fill in, then bring the service up with:
#
#   docker compose --env-file immich.env -f immich.yml up -d
#
# Never commit the real immich.env. On the live host it is chmod 600, and the
# .gitignore here already covers it.
#
# Named after the service rather than a shared .env: a single .env gets overwritten
# when you set up the next service, and the immich.yml filename is not one Compose
# auto-detects, so both the file and the flag have to be explicit.

DB_USERNAME=immich
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./data
UPLOAD_LOCATION=./upload
IMMICH_VERSION=release
