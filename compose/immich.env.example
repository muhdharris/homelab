# Immich — photo and video management
#
# Copy to .env beside immich.yml and fill in. Never commit the real .env.
# On the live host .env is chmod 600.
#
# One file per service on purpose: each service has its own credentials, so a
# single shared example would silently resolve to whichever service came last.

DB_USERNAME=immich
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./data
UPLOAD_LOCATION=./upload
IMMICH_VERSION=release
